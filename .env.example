# =============================================================================
# RealityEngine_CI — environment configuration
# Copy to .env and edit before running startUniverse.sh.
#
#   cp .env.example .env
#   # edit .env
#   bash scripts/setup.sh          # generates TLS certs if missing
#   ./startUniverse.sh
# =============================================================================

# ── Reality Engine ──────────────────────────────────────────────────────────

# Perceptual space dimension. Must match across all repos and the Qdrant collection.
# Changing this after first run requires --fresh to clear the perception volume.
VECTOR_DIMENSION=7680

# Canonical public endpoints. Docker Scala RE is proxied to :5001 by nginx.
# Native runtimes: Scala RE=5001/PE=5000, CPP RE=5301/PE=5300, LSP RE=5601/PE=5600.
# Grafana is at https://localhost:3000 (Docker only; plain HTTP on internal port 3000).
REALITY_ENGINE_URL=https://localhost:5001
PERCEPTION_ENGINE_URL=https://localhost:3004
RE_REGISTRY_URL=http://localhost:5999/re-registry.json

# Qdrant collection name for the RE vector store.
COLLECTION_NAME=reality-vectors

# ── localAIStack ─────────────────────────────────────────────────────────────

# Embedding model served by Ollama. Must be pulled before starting:
#   ollama pull ternary-bonsai:4
EMBED_MODEL=ternary-bonsai:4

# ── TLS Certificates ─────────────────────────────────────────────────────────
# Run `bash scripts/setup.sh` to generate dev certs automatically.
# Cert files are expected at: certs/server.crt, certs/server.key,
# certs/ca.crt, certs/keystore.p12
#
# IMPORTANT: Change KEYSTORE_PASSWORD before deploying to any shared or
# production environment.  The default is for local dev only.
KEYSTORE_PASSWORD=realityengine

# ── Optional: MQTT Bridge ────────────────────────────────────────────────────
# Only needed when using --mqtt-broker-url flag with startUniverse.sh.
# MQTT_BROKER_URL=mqtt://your-broker:1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
# MQTT_CLIENT_ID=reality-engine-pe
# MQTT_KEEPALIVE=60
# MQTT_DISABLED=false

# Optional ACP/OpenClaw handoff wiring for PE.
ACP_ENABLED=true
ACP_GATEWAY_URL=ws://127.0.0.1:18789
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
ACP_SESSION_KEY=agent:main:main
ACP_TARGET_AGENT=openclaw
ACP_COMPLETION_SOURCE_MAPPING_ID=acp-openclaw-completion
INTEGRATIONS_CONFIG=config/integrations.json

# HealthKit ingest auth. Leave blank to let startUniverse.sh generate and
# persist a stable token at config/.healthkit-bridge-token (the paired iOS
# bridge must send the same value as Authorization: Bearer). Set a fixed value
# to pin it, or pass --no-healthkit-token to disable auth entirely (dev mode).
HEALTHKIT_BRIDGE_TOKEN=

# ── Native Engine Port Bases ─────────────────────────────────────────────────
# Default: Scala PE=5000, CPP PE=5300, LSP PE=5600 (per DEPLOYMENT_CONTRACT.md).
# macOS AirPlay Receiver occupies port 5000; set SCALA_PE_BASE=5100 to avoid conflict.
# SCALA_PE_BASE=5000
# CPP_PE_BASE=5300
# LSP_PE_BASE=5600
