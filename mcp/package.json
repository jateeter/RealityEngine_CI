{
  "name": "@realityengine/mcp-gateway",
  "version": "1.1.0",
  "description": "Model Context Protocol gateway packaging the RealityEngine RE/PE HTTP surfaces (CPP, LSP, Scala) as MCP tools and resources.",
  "type": "module",
  "private": true,
  "bin": {
    "realityengine-mcp": "bin/realityengine-mcp.js"
  },
  "exports": {
    ".": "./src/server.js"
  },
  "scripts": {
    "start": "node bin/realityengine-mcp.js",
    "start:http": "node src/http-server.js",
    "list-tools": "node bin/realityengine-mcp.js --list-tools",
    "manifest:gen": "node scripts/gen-manifest.mjs",
    "manifest:check": "node scripts/gen-manifest.mjs --check",
    "test": "node --test test/*.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.0"
  }
}
