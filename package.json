{
  "name": "reality-engine-ci",
  "version": "1.0.0",
  "description": "CI orchestrator and full-stack end-to-end (Playwright) tests for the RealityEngine universe",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bash scripts/run-all-tests.sh --unit",
    "test:e2e": "bash scripts/run-all-tests.sh --e2e",
    "test:all": "bash scripts/run-all-tests.sh --all",
    "test:deployment": "bash scripts/run-all-tests.sh --deployment",
    "test:regression": "bash scripts/regression-test.sh",
    "test:playwright": "playwright test",
    "test:e2e:tree-pe-manager": "playwright test e2e/tests/tree-to-pe-manager-equivalence.spec.ts --project=chromium --workers=1",
    "test:e2e:openclaw": "bash scripts/test-openclaw-integration.sh",
    "test:openclaw-adapter": "node --test scripts/tests/openclaw-acp-adapter.test.mjs scripts/tests/openclaw-acp-adapter-e2e.test.mjs",
    "test:regression-issue-filer": "node --test scripts/tests/regression-issue-filer.test.mjs",
    "openclaw:adapter": "node scripts/openclaw-acp-adapter.mjs",
    "bridge:metrics": "node scripts/bridge-metrics-exporter.mjs",
    "openapi:gen": "bash scripts/generate-openapi.sh",
    "openapi:serve": "bash scripts/serve-openapi.sh",
    "mcp": "node mcp/bin/realityengine-mcp.js",
    "mcp:http": "node mcp/src/http-server.js",
    "mcp:tools": "node mcp/bin/realityengine-mcp.js --list-tools",
    "mcp:manifest:check": "npm --prefix mcp run manifest:check",
    "mcp:openai-profile:gen": "npm --prefix mcp run openai-profile:gen",
    "mcp:openai-profile:check": "npm --prefix mcp run openai-profile:check",
    "test:report": "playwright show-report e2e-report",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=25.5.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.4.0"
  }
}
