# re-init: configures a RealityEngine install, and serves its instance registry
# (ReleaseRoadmap C2). See reinit.py for what it writes.
#
# Built from RealityEngine_CI with localOpenClawStack as the named context
# `ocs` (release/images.json), so OpenClaw's config is generated by that
# repo's own scripts at the release commit:
#
#   docker buildx build -f release/init/Dockerfile --build-context ocs=../localOpenClawStack .
FROM python:3.12-slim@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1

# jq, bash and perl's shasum for localOpenClawStack's scripts (agent-profile.sh
# hashes a corpus manifest with shasum); openssl for the local CA.
RUN apt-get update \
    && apt-get install -y --no-install-recommends bash jq perl openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# What a release install is made of.
COPY release/compose.yml release/images.json /opt/release/
COPY release/config/ /opt/release/config/
COPY release/realityengine /opt/release/realityengine

# The RealityEngine_CI files an install needs, unchanged: the instance UUID
# allocator (#296), the integration registry template, and the monitoring
# configuration and dashboards.
COPY scripts/lib/instance_uuids.py /opt/ci/scripts/lib/
COPY scripts/bridge-metrics-exporter.mjs /opt/ci/scripts/
COPY config/integrations.example.json config/loki-config.yml config/grafana-datasources.yml \
     config/grafana-dashboards.yml config/regression-corpus.txt /opt/ci/config/
COPY config/dashboards/ /opt/ci/config/dashboards/

# localOpenClawStack at the release commit: its config scripts and the agent
# corpus with its profiles.
# `ocs` is a named build context (release/images.json), not a stage.
# hadolint ignore=DL3022
COPY --from=ocs scripts/ /opt/ocs/scripts/
# hadolint ignore=DL3022
COPY --from=ocs machine-behaviors/ /opt/ocs/machine-behaviors/
# The sandbox image's Dockerfile, copied with the scripts into the install for
# the native gateway on the Mac (RealityEngine_CI#592).
COPY --from=ocs docker/ /opt/ocs/docker/

COPY release/init/reinit.py /usr/local/bin/reinit
RUN chmod 755 /usr/local/bin/reinit /opt/release/realityengine

# Unprivileged by default: that is how the instance-registry service runs it.
# The one-shot jobs (configure, prepare-volumes, machines-*) write the install
# directory and set ownership the gateway (node, 1000) and the engines' clock
# volume need, so the release compose and the installer run those as root,
# explicitly, per job.
RUN groupadd -r -g 1001 reinit && useradd -r -u 1001 -g reinit reinit
USER 1001
ENTRYPOINT ["/usr/local/bin/reinit"]
CMD ["--help"]
