#!/bin/bash
# realityengine — install and run the RealityEngine suite from its release images.
#
#   realityengine install [--version release-v0.0.1] [--engines cpp:1,lsp:1,scala:1]
#   realityengine up      [--engines SPEC]     re-configure for a spec and start
#   realityengine down                         stop (data is kept)
#   realityengine status                       what is installed and running
#   realityengine logs    [SERVICE]
#   realityengine upgrade --to VERSION         move to another release, data kept
#   realityengine uninstall [--purge]          remove; --purge also deletes data
#   realityengine trust-ca                     trust the install's local CA (Keychain)
#   realityengine machines list                the Load Machines catalog, by domain
#   realityengine machines sync [--ref REF]    refresh the catalog from RealityEngine_Machines
#                                              on GitHub (default main), validated first
#   realityengine machines load --domain D | --machine M | --all
#                                              load catalog machines into every engine
#   realityengine host-check [--json]          check Ollama, OpenClaw and Node against this release
#                                              (no Docker needed); records state/host-services.json
#   realityengine reembed [status|run|rollback|drop-old] [COLLECTION ...]
#                                              rebuild localAI's Qdrant collections after the
#                                              embedding model changes (vectors from two models
#                                              do not mix); up and upgrade run it when needed
#
# Options for install/up/upgrade:
#   --dir DIR        install directory (default ~/.realityengine)
#   --images FILE    the release's images file (digests); a release install uses it
#   --local          use images already loaded in Docker, never pull (development)
#   --registry REG   image registry (default ghcr.io/jateeter)
#
# Runs on the stock macOS /bin/bash (3.2): a clean Mac has nothing else. All the
# configuration is made by the re-init image (ReleaseRoadmap C2, C3); this script
# only checks the Mac, runs re-init, and drives docker compose.
set -eu

PROG=realityengine
DIR="${REALITYENGINE_DIR:-$HOME/.realityengine}"
# The compose project, fixed at the first configure: a second install (the
# regression lane's re-regression) needs its own volumes and network.
PROJECT="${REALITYENGINE_PROJECT:-realityengine}"
REGISTRY="ghcr.io/jateeter"
VERSION=""
ENGINES=""
IMAGES=""
LOCAL=false
PURGE=false
TO=""
REF="main"
ALL=false
LOAD_ARGS=""
MIN_MACOS=26
MIN_DOCKER_MEM_GB=8

say()  { printf '\033[0;36m[%s]\033[0m %s\n' "$PROG" "$*"; }
ok()   { printf '\033[0;32m[ok]\033[0m   %s\n' "$*"; }
warn() { printf '\033[1;33m[warn]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[0;31m[error]\033[0m %s\n' "$*" >&2; exit 1; }

usage() { sed -n '2,26p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

# ── arguments ────────────────────────────────────────────────────────────────
CMD="${1:-}"; [ -n "$CMD" ] || usage 1; shift
while [ $# -gt 0 ]; do
  case "$1" in
    --version) VERSION="$2"; shift 2 ;;
    --version=*) VERSION="${1#*=}"; shift ;;
    --engines) ENGINES="$2"; shift 2 ;;
    --engines=*) ENGINES="${1#*=}"; shift ;;
    --dir) DIR="$2"; shift 2 ;;
    --dir=*) DIR="${1#*=}"; shift ;;
    --images) IMAGES="$2"; shift 2 ;;
    --images=*) IMAGES="${1#*=}"; shift ;;
    --registry) REGISTRY="$2"; shift 2 ;;
    --registry=*) REGISTRY="${1#*=}"; shift ;;
    --to) TO="$2"; shift 2 ;;
    --to=*) TO="${1#*=}"; shift ;;
    --local) LOCAL=true; shift ;;
    --ref) REF="$2"; shift 2 ;;
    --ref=*) REF="${1#*=}"; shift ;;
    --domain) LOAD_ARGS="$LOAD_ARGS --domain $2"; shift 2 ;;
    --domain=*) LOAD_ARGS="$LOAD_ARGS --domain ${1#*=}"; shift ;;
    --machine) LOAD_ARGS="$LOAD_ARGS --machine $2"; shift 2 ;;
    --machine=*) LOAD_ARGS="$LOAD_ARGS --machine ${1#*=}"; shift ;;
    --all) ALL=true; shift ;;
    --purge) PURGE=true; shift ;;
    -h|--help) usage 0 ;;
    *) ARGS_REST="${ARGS_REST:-} $1"; shift ;;
  esac
done

CONF="$DIR/cli.conf"
# What the install was made with; flags override it.
if [ -f "$CONF" ]; then
  # shellcheck disable=SC1090
  . "$CONF"
  VERSION="${VERSION:-${CONF_VERSION:-}}"
  ENGINES="${ENGINES:-${CONF_ENGINES:-}}"
  IMAGES="${IMAGES:-${CONF_IMAGES:-}}"
  [ "$LOCAL" = true ] || LOCAL="${CONF_LOCAL:-false}"
  REGISTRY="${CONF_REGISTRY:-$REGISTRY}"
fi
ENGINES="${ENGINES:-cpp:1,lsp:1,scala:1}"

# From the install directory: COMPOSE_FILE in its .env is relative, and compose
# resolves it against the working directory.
compose() { (cd "$DIR" && docker compose "$@"); }

save_conf() {
  mkdir -p "$DIR"
  {
    echo "CONF_VERSION=$VERSION"
    echo "CONF_ENGINES=$ENGINES"
    echo "CONF_IMAGES=$IMAGES"
    echo "CONF_LOCAL=$LOCAL"
    echo "CONF_REGISTRY=$REGISTRY"
  } > "$CONF"
}

# ── checks ───────────────────────────────────────────────────────────────────
preflight() {
  say "Checking this Mac"
  [ "$(uname -s)" = Darwin ] || die "RealityEngine release installs run on macOS."
  major="$(sw_vers -productVersion | cut -d. -f1)"
  [ "$major" -ge "$MIN_MACOS" ] || die "macOS $MIN_MACOS or later is required (this Mac runs $(sw_vers -productVersion))."
  [ "$(uname -m)" = arm64 ] || die "An Apple Silicon Mac (M1 or later) is required; the images are linux/arm64 only."
  ok "macOS $(sw_vers -productVersion), Apple Silicon"

  command -v docker >/dev/null 2>&1 || die "Docker Desktop is required: https://www.docker.com/products/docker-desktop/"
  docker info >/dev/null 2>&1 || die "Docker is installed but not running. Start Docker Desktop and try again."
  docker compose version >/dev/null 2>&1 || die "docker compose v2 is required (it ships with Docker Desktop)."
  os="$(docker info --format '{{.OperatingSystem}}' 2>/dev/null || true)"
  case "$os" in
    *"Docker Desktop"*) ok "Docker Desktop $(docker version --format '{{.Server.Version}}' 2>/dev/null)" ;;
    *) warn "The container runtime is '$os'. Only Docker Desktop is tested (A5)." ;;
  esac
  mem_gb=$(( $(docker info --format '{{.MemTotal}}' 2>/dev/null || echo 0) / 1073741824 ))
  if [ "$mem_gb" -lt "$MIN_DOCKER_MEM_GB" ]; then
    warn "Docker Desktop has ${mem_gb} GB of memory; give it at least ${MIN_DOCKER_MEM_GB} GB (Settings > Resources) for $ENGINES."
  else
    ok "Docker memory ${mem_gb} GB"
  fi
  free_gb=$(df -g "$HOME" | awk 'NR==2 {print $4}')
  [ "${free_gb:-0}" -ge 20 ] || warn "Only ${free_gb} GB free on disk; the images need about 20 GB."

  host_gate strict
  check_ollama
}

# ── host services (RealityEngine_CI#592) ─────────────────────────────────────
# Ollama and OpenClaw run natively on the Mac. These constants mirror
# release/host-requirements.json (scripts/tests/test-host-preflight.sh keeps them
# equal; this script ships alone, so it cannot read the file).
HOST_REQ_NODE=26.12.1
HOST_REQ_OLLAMA_MIN=0.40.0
HOST_REQ_OPENCLAW_MIN=2026.10.5
HOST_REQ_OPENCLAW_REQUIRED=true
HOST_MILESTONE=release-v0.0.1-rc3
HOST_ISSUE_REPO=jateeter/RealityEngine_CI

# The first dotted number in the input: "ollama version is 0.40.6" -> 0.40.6
ver_num() { sed -n 's/^[^0-9]*\([0-9][0-9]*\(\.[0-9][0-9]*\)\{1,3\}\).*/\1/p' | head -1; }

# ver_ge A B: success when A >= B, comparing dotted numbers part by part.
ver_ge() {
  local IFS=. i x y
  local -a a b
  # shellcheck disable=SC2206  # splitting on the dots is the point
  a=($1); b=($2)
  for i in 0 1 2 3; do
    x="${a[$i]:-0}"; y="${b[$i]:-0}"
    [ "$x" -gt "$y" ] && return 0
    [ "$x" -lt "$y" ] && return 1
  done
  return 0
}

# Each probe sets its variables; empty means absent.
probe_ollama() {
  OLLAMA_VER=""; OLLAMA_NOTE=""
  local v
  v="$(curl -fsS --max-time 3 http://127.0.0.1:11434/api/version 2>/dev/null | ver_num || true)"
  if [ -n "$v" ]; then OLLAMA_VER="$v"; OLLAMA_NOTE="running"; return 0; fi
  if command -v ollama >/dev/null 2>&1; then
    v="$(ollama --version 2>/dev/null | ver_num || true)"
    if [ -n "$v" ]; then OLLAMA_VER="$v"; OLLAMA_NOTE="installed, not running"; fi
  fi
  return 0
}

# OpenClaw and the exact node it runs on: the interpreter on its first line, so
# an nvm or Homebrew node elsewhere on PATH cannot stand in for it.
#
# The binary is the one the native gateway's LaunchAgent runs
# (localOpenClawStack scripts/native-gateway.sh): OPENCLAW_BIN, then Homebrew's
# npm prefix, then PATH. PATH alone found a ~/.local/bin wrapper first on the build
# Mac, a bash script that execs node itself, and reported "Node ?".
probe_openclaw() {
  OPENCLAW_VER=""; OPENCLAW_NODE=""; OPENCLAW_NODE_VER=""; OPENCLAW_NOTE=""
  OPENCLAW_BIN="${RE_OPENCLAW_BIN:-${OPENCLAW_BIN:-}}"
  if [ -z "$OPENCLAW_BIN" ]; then
    if [ -x /opt/homebrew/bin/openclaw ]; then OPENCLAW_BIN=/opt/homebrew/bin/openclaw
    else OPENCLAW_BIN="$(command -v openclaw 2>/dev/null || true)"; fi
  fi
  [ -n "$OPENCLAW_BIN" ] && [ -x "$OPENCLAW_BIN" ] || { OPENCLAW_BIN=""; return 0; }
  OPENCLAW_VER="$("$OPENCLAW_BIN" --version 2>/dev/null | ver_num || true)"
  local real shebang t
  real="$OPENCLAW_BIN"
  while [ -L "$real" ]; do
    t="$(readlink "$real")"
    case "$t" in /*) real="$t" ;; *) real="$(dirname "$real")/$t" ;; esac
  done
  shebang="$(head -1 "$real" 2>/dev/null || true)"
  case "$shebang" in
    # env node: the node beside the bin (npm -g installs into node's own prefix),
    # which the LaunchAgent puts first on its PATH; else PATH's.
    '#!/usr/bin/env node'*)
      if [ -x "$(dirname "$OPENCLAW_BIN")/node" ]; then OPENCLAW_NODE="$(dirname "$OPENCLAW_BIN")/node"
      else OPENCLAW_NODE="$(command -v node 2>/dev/null || true)"; fi ;;
    '#!'*node*) OPENCLAW_NODE="$(printf '%s' "${shebang#\#!}" | awk '{print $1}')" ;;
    # A shell wrapper that execs a node by path: exec "/path/node" ".../entry.js".
    '#!'*sh*)
      OPENCLAW_NODE="$(sed -n 's/^[[:space:]]*exec[[:space:]]\{1,\}"\{0,1\}\([^" ]*\/node\)"\{0,1\}[[:space:]].*/\1/p' "$real" | head -1)"
      [ -n "$OPENCLAW_NODE" ] || OPENCLAW_NOTE="a shell wrapper that names no node" ;;
    *) OPENCLAW_NOTE="not a node script" ;;
  esac
  if [ -n "$OPENCLAW_NODE" ]; then
    OPENCLAW_NODE_VER="$("$OPENCLAW_NODE" --version 2>/dev/null | ver_num || true)"
    if [ -z "$OPENCLAW_NODE_VER" ]; then OPENCLAW_NOTE="$OPENCLAW_NODE does not run"; fi
  fi
  return 0
}

# The current public release; empty when it cannot be looked up (never a pass).
# RE_LATEST_OLLAMA / RE_LATEST_OPENCLAW stand in for the lookup in tests.
latest_ollama() {
  if [ -n "${RE_LATEST_OLLAMA+x}" ]; then printf '%s' "$RE_LATEST_OLLAMA"; return 0; fi
  curl -fsS --max-time 5 https://api.github.com/repos/ollama/ollama/releases/latest 2>/dev/null \
    | sed -n 's/.*"tag_name": *"v\{0,1\}\([^"]*\)".*/\1/p' | head -1
}
latest_openclaw() {
  if [ -n "${RE_LATEST_OPENCLAW+x}" ]; then printf '%s' "$RE_LATEST_OPENCLAW"; return 0; fi
  curl -fsS --max-time 5 https://registry.npmjs.org/openclaw/latest 2>/dev/null \
    | sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' | head -1
}

# Findings, one per line "service|kind|installed|wanted|fix": kind is fail or behind.
HOST_FINDINGS=""
HOST_LOOKUPS_SKIPPED=""
finding() { HOST_FINDINGS="${HOST_FINDINGS}$1|$2|$3|$4|$5
"; }

OLLAMA_FIX="Install the current Ollama.app: https://github.com/ollama/ollama/releases/latest (the Homebrew cask lags)"
OPENCLAW_FIX="npm install -g openclaw@latest   (needs Node $HOST_REQ_NODE: https://nodejs.org/dist/v$HOST_REQ_NODE/)"
NODE_FIX="Install Node $HOST_REQ_NODE (the .pkg from https://nodejs.org/dist/v$HOST_REQ_NODE/), put it first on PATH, then: npm install -g openclaw@latest"

# Probe, compare, record. Sets HOST_FINDINGS and writes $DIR/state/host-services.json.
host_check() {
  HOST_FINDINGS=""; HOST_LOOKUPS_SKIPPED=""
  probe_ollama; probe_openclaw
  local lo lc
  lo="$(latest_ollama || true)"; lc="$(latest_openclaw || true)"
  [ -n "$lo" ] || HOST_LOOKUPS_SKIPPED="${HOST_LOOKUPS_SKIPPED}ollama "
  [ -n "$lc" ] || HOST_LOOKUPS_SKIPPED="${HOST_LOOKUPS_SKIPPED}openclaw "
  OLLAMA_LATEST="$lo"; OPENCLAW_LATEST="$lc"

  OLLAMA_STATUS=ok
  if [ -z "$OLLAMA_VER" ]; then
    OLLAMA_STATUS=missing
    warn "Ollama was not found. Local AI needs it. $OLLAMA_FIX"
  elif ! ver_ge "$OLLAMA_VER" "$HOST_REQ_OLLAMA_MIN"; then
    OLLAMA_STATUS=below-min
    finding Ollama fail "$OLLAMA_VER" ">= $HOST_REQ_OLLAMA_MIN (MLX)" "$OLLAMA_FIX"
  elif [ -n "$lo" ] && ! ver_ge "$OLLAMA_VER" "$lo"; then
    OLLAMA_STATUS=behind
    finding Ollama behind "$OLLAMA_VER" "$lo" "$OLLAMA_FIX"
  fi

  OPENCLAW_STATUS=ok
  if [ -z "$OPENCLAW_BIN" ]; then
    OPENCLAW_STATUS=missing
    if [ "$HOST_REQ_OPENCLAW_REQUIRED" = true ]; then
      finding OpenClaw fail "" ">= $HOST_REQ_OPENCLAW_MIN" "$OPENCLAW_FIX"
    else
      warn "OpenClaw was not found on PATH (the gateway still runs in a container in this release)."
    fi
  elif [ -z "$OPENCLAW_VER" ]; then
    OPENCLAW_STATUS=unreadable
    finding OpenClaw fail "?" ">= $HOST_REQ_OPENCLAW_MIN" "$OPENCLAW_FIX"
  elif ! ver_ge "$OPENCLAW_VER" "$HOST_REQ_OPENCLAW_MIN"; then
    OPENCLAW_STATUS=below-min
    finding OpenClaw fail "$OPENCLAW_VER" ">= $HOST_REQ_OPENCLAW_MIN" "$OPENCLAW_FIX"
  elif [ -n "$lc" ] && ! ver_ge "$OPENCLAW_VER" "$lc"; then
    OPENCLAW_STATUS=behind
    finding OpenClaw behind "$OPENCLAW_VER" "$lc" "$OPENCLAW_FIX"
  fi

  NODE_STATUS=ok
  if [ -n "$OPENCLAW_BIN" ]; then
    if [ -z "$OPENCLAW_NODE_VER" ]; then
      NODE_STATUS=unreadable
      finding Node fail "?" "$HOST_REQ_NODE" "$NODE_FIX"
    elif [ "$OPENCLAW_NODE_VER" != "$HOST_REQ_NODE" ]; then
      NODE_STATUS=mismatch
      if [ "$HOST_REQ_OPENCLAW_REQUIRED" = true ]; then
        finding Node fail "$OPENCLAW_NODE_VER" "$HOST_REQ_NODE" "$NODE_FIX"
      else
        warn "OpenClaw runs on Node $OPENCLAW_NODE_VER; this release pins $HOST_REQ_NODE. $NODE_FIX"
      fi
    fi
  fi
  host_record
}

json_str() { printf '"%s"' "$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')"; }

host_services_json() {
  local skipped="false"; [ -n "$HOST_LOOKUPS_SKIPPED" ] && skipped="true"
  printf '{\n  "checked_at": %s,\n  "release": %s,\n  "lookups_skipped": %s,\n' \
    "$(json_str "$(date -u +%Y-%m-%dT%H:%M:%SZ)")" "$(json_str "$HOST_MILESTONE")" "$skipped"
  printf '  "ollama":   {"installed": %s, "latest": %s, "min": %s, "status": %s, "note": %s},\n' \
    "$(json_str "$OLLAMA_VER")" "$(json_str "$OLLAMA_LATEST")" "$(json_str "$HOST_REQ_OLLAMA_MIN")" "$(json_str "$OLLAMA_STATUS")" "$(json_str "$OLLAMA_NOTE")"
  printf '  "openclaw": {"installed": %s, "latest": %s, "min": %s, "status": %s, "bin": %s, "note": %s},\n' \
    "$(json_str "$OPENCLAW_VER")" "$(json_str "$OPENCLAW_LATEST")" "$(json_str "$HOST_REQ_OPENCLAW_MIN")" "$(json_str "$OPENCLAW_STATUS")" "$(json_str "$OPENCLAW_BIN")" "$(json_str "$OPENCLAW_NOTE")"
  printf '  "node":     {"installed": %s, "required": %s, "status": %s, "bin": %s}\n}\n' \
    "$(json_str "$OPENCLAW_NODE_VER")" "$(json_str "$HOST_REQ_NODE")" "$(json_str "$NODE_STATUS")" "$(json_str "$OPENCLAW_NODE")"
}

host_record() {
  mkdir -p "$DIR/state"
  host_services_json > "$DIR/state/host-services.json"
}

# Say what was found. A lookup that failed is reported, never read as "current".
host_report() {
  [ -z "$OLLAMA_VER" ] || ok "Ollama $OLLAMA_VER ($OLLAMA_NOTE)"
  [ -z "$OPENCLAW_VER" ] || ok "OpenClaw $OPENCLAW_VER ($OPENCLAW_BIN) on Node ${OPENCLAW_NODE_VER:-?}"
  if [ -n "$HOST_LOOKUPS_SKIPPED" ]; then
    warn "Could not look up the current release of: ${HOST_LOOKUPS_SKIPPED}(offline?). Version currency was NOT checked."
  fi
  local svc kind inst want fix
  while IFS='|' read -r svc kind inst want fix; do
    [ "$kind" = behind ] || continue
    warn "$svc ${inst:-?} is behind the current release $want. $fix"
  done <<EOF2
$HOST_FINDINGS
EOF2
  host_report_updates
}

# Behind-the-release findings become one issue each where gh can file against
# this repo, else a note in $DIR/state/host-updates.md. Never a duplicate.
host_report_updates() {
  local md="$DIR/state/host-updates.md" body="" svc kind inst want fix title
  while IFS='|' read -r svc kind inst want fix; do
    [ "$kind" = behind ] || continue
    title="Host update: $svc $want available (installed ${inst:-none})"
    if host_file_issue "$title" "$fix"; then continue; fi
    body="${body}- $title"$'\n'"  $fix"$'\n'
  done <<EOF2
$HOST_FINDINGS
EOF2
  if [ -n "$body" ]; then
    mkdir -p "$DIR/state"
    printf '# Host updates available (%s)\n\n%s' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$body" > "$md"
    warn "Updates are listed in $md"
  else
    rm -f "$md"
  fi
}

# Success when an issue now exists (created or refreshed); failure means "use the file".
host_file_issue() { # title fix
  local gh="${RE_GH:-gh}" perm n text
  [ "${RE_HOST_UPDATE_ISSUES:-1}" = 0 ] && return 1
  command -v "$gh" >/dev/null 2>&1 || return 1
  perm="$("$gh" repo view "$HOST_ISSUE_REPO" --json viewerPermission -q .viewerPermission 2>/dev/null || true)"
  case "$perm" in WRITE|MAINTAIN|ADMIN) ;; *) return 1 ;; esac
  text="Found by 'realityengine' on $(date -u +%Y-%m-%d). Fix: $2"
  n="$("$gh" issue list --repo "$HOST_ISSUE_REPO" --label host-update --state open --limit 100 --json number,title \
        -q ".[] | select(.title == \"$1\") | .number" 2>/dev/null | head -1 || true)"
  if [ -n "$n" ]; then
    "$gh" issue edit "$n" --repo "$HOST_ISSUE_REPO" --body "$text" >/dev/null 2>&1 || return 1
    say "Host update issue #$n refreshed"
  else
    "$gh" label create host-update --repo "$HOST_ISSUE_REPO" --color BFD4F2 --description "A host service is behind its current release" >/dev/null 2>&1 || true
    "$gh" issue create --repo "$HOST_ISSUE_REPO" --title "$1" --body "$text" --label host-update --milestone "$HOST_MILESTONE" >/dev/null 2>&1 \
      || "$gh" issue create --repo "$HOST_ISSUE_REPO" --title "$1" --body "$text" --label host-update >/dev/null 2>&1 || return 1
    say "Filed: $1"
  fi
}

# Fail (strict) when a host service is below what this release needs.
host_gate() { # strict|warn
  host_check
  host_report
  local svc kind inst want fix failed=""
  while IFS='|' read -r svc kind inst want fix; do
    [ "$kind" = fail ] || continue
    printf '\033[0;31m[error]\033[0m %s %s does not meet this release (needs %s).\n         %s\n' "$svc" "${inst:-not found}" "$want" "$fix" >&2
    failed=yes
  done <<EOF2
$HOST_FINDINGS
EOF2
  if [ -n "$failed" ] && [ "$1" = strict ]; then
    die "Host services are not ready. Fix the above and run again."
  fi
  [ -z "$failed" ] || warn "Continuing: host service requirements are not met."
  return 0
}

# Where a model runs: Ollama reports it per model (details.runner). Empty when
# unknown. perl ships with macOS; without it the runner is simply not reported.
model_runner() { # tags-json model
  command -v perl >/dev/null 2>&1 || return 0
  printf '%s' "$1" | M="$2" perl -0777 -ne 'my $m = $ENV{M}; while (/\{"name":"([^"]+)"((?:(?!\{"name":).)*)/gs) { if ($1 eq $m || $1 eq "$m:latest") { print(($2 =~ /"runner":"([^"]*)"/)[0] // ""); exit } }'
}

check_ollama() {
  # Ollama runs natively on the Mac, for the Apple GPU (A6).
  v="$(curl -fsS --max-time 3 http://127.0.0.1:11434/api/version 2>/dev/null || true)"
  case "$v" in
    *'"version"'*) ok "Ollama $(printf '%s' "$v" | sed 's/.*"version":"\([^"]*\)".*/\1/') on :11434" ;;
    *) warn "Ollama is not answering on 127.0.0.1:11434. Install it (https://ollama.com or 'brew install ollama'), start it, and run 'ollama pull nemotron-3-nano:4b'. The suite starts without it, but local AI will report it unreachable."; return 0 ;;
  esac
  # The engines' and OpenClaw's model, and localAI's embedding model. Both run on
  # MLX (RealityEngine_CI#593: each role's default must).
  tags="$(curl -fsS --max-time 5 http://127.0.0.1:11434/api/tags 2>/dev/null || true)"
  for m in nemotron-3-nano:4b "${EMBED_MODEL:-embeddinggemma-2:270m}"; do
    if printf '%s' "$tags" | grep -q "\"$m\(:latest\)\{0,1\}\""; then
      ok "model $m present"
      r="$(model_runner "$tags" "$m")"
      case "$r" in
        mlx) ok "  $m runs on MLX" ;;
        "") ;;
        *) warn "  $m runs on '$r', not MLX. A role's default model must run on MLX (RealityEngine_CI#593)." ;;
      esac
    else
      warn "Model $m is missing. Run: ollama pull $m"
    fi
  done
}

port_in_use() { lsof -nP -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1; }

check_ports() {
  # Ports held by this install's own containers are fine (an `up` over a running
  # install); anything else holding one is a conflict.
  busy=""
  for p in "${RE_PORT_MANAGER_UI:-5173}" "${RE_PORT_MANAGER_API:-3001}" "${RE_PORT_LOCALAI:-4000}" \
           "${RE_PORT_OPENCLAW:-18789}" "${RE_PORT_WEBUI:-8080}" "${RE_PORT_PIM:-8090}" \
           "${RE_PORT_CSS:-13000}" "${RE_PORT_MCP:-7331}" "${RE_PORT_REGISTRY:-5999}" \
           "${RE_PORT_GRAFANA:-3002}" "${RE_PORT_PROMETHEUS:-9090}" "${RE_PORT_QDRANT:-4333}" \
           "${RE_PORT_BROWSER_CDP:-9222}"; do
    # The gateway's port is held by its own LaunchAgent between an `up` and the next.
    if [ "$p" = "${RE_PORT_OPENCLAW:-18789}" ] && gateway_pid >/dev/null; then
      [ "$(lsof -nP -tiTCP:"$p" -sTCP:LISTEN 2>/dev/null | head -1)" = "$(gateway_pid)" ] && continue
    fi
    if port_in_use "$p" && ! compose ps --format '{{.Ports}}' 2>/dev/null | grep -q ":$p->"; then
      busy="$busy $p"
    fi
  done
  [ -z "$busy" ] || die "Port(s)$busy are in use by something else. Stop it, or move a port: RE_PORT_<NAME>=<port> (see INSTALL.md)."
}

host_ip() {
  ip="$(ipconfig getifaddr en0 2>/dev/null || true)"
  [ -n "$ip" ] || ip="$(ipconfig getifaddr en1 2>/dev/null || true)"
  printf '%s' "${ip:-127.0.0.1}"
}

init_image() {
  if [ -n "$IMAGES" ] && [ -f "$IMAGES" ]; then
    ref="$(sed -n 's/.*"ref": *"\([^"]*re-init\)".*/\1/p' "$IMAGES" | head -1)"
    dg="$(awk '/"name": *"re-init"/{f=1} f && /"digest"/{print; exit}' "$IMAGES" | sed 's/.*"digest": *"\([^"]*\)".*/\1/')"
    if [ -n "$ref" ] && [ -n "$dg" ] && [ "$dg" != null ]; then printf '%s@%s' "$ref" "$dg"; return; fi
  fi
  printf '%s/re-init:%s' "$REGISTRY" "$VERSION"
}

# ── steps ────────────────────────────────────────────────────────────────────
# The OpenClaw gateway is the Mac's own openclaw, a user LaunchAgent on loopback
# (RealityEngine_CI#592). re-init generates its home in <install>/openclaw and
# copies localOpenClawStack's scripts to <install>/ocs; these start and stop it.
GATEWAY_LABEL="org.realityengine.openclaw-gateway"
gateway_pid() {
  launchctl print "gui/$(id -u)/$GATEWAY_LABEL" 2>/dev/null | awk '/^\tpid = /{print $3; found=1} END{exit !found}'
}
gateway_env() {
  # shellcheck disable=SC1091
  [ -f "$DIR/.env" ] && . "$DIR/.env"
  probe_openclaw
  env OPENCLAW_VERSION="$OPENCLAW_VER" OPENCLAW_BIN="$OPENCLAW_BIN" OPENCLAW_NATIVE_HOME="$DIR/openclaw" \
    OPENCLAW_GATEWAY_PORT="${RE_PORT_OPENCLAW:-18789}" RE_PORT_BROWSER_CDP="${RE_PORT_BROWSER_CDP:-9222}" \
    OPENCLAW_NODE_EXACT="$HOST_REQ_NODE" "$@"
}
gateway_up() {
  [ -x "$DIR/ocs/scripts/native-gateway.sh" ] || die "The OpenClaw scripts are missing from $DIR/ocs; run: $PROG up"
  say "Starting the OpenClaw gateway (the Mac's openclaw, LaunchAgent $GATEWAY_LABEL)"
  gateway_env bash "$DIR/ocs/scripts/native-gateway.sh" up --no-generate \
    || die "The OpenClaw gateway did not start. Its log: $DIR/openclaw/logs/gateway.log"
}
gateway_down() {
  [ -x "$DIR/ocs/scripts/native-gateway.sh" ] || return 0
  gateway_env bash "$DIR/ocs/scripts/native-gateway.sh" down >/dev/null 2>&1 || true
}

configure() {
  [ -n "$VERSION" ] || die "No version. Pass --version (for example --version release-v0.0.1)."
  mkdir -p "$DIR"
  img="$(init_image)"
  if [ "$LOCAL" != true ]; then
    say "Pulling $img"
    docker pull -q "$img" >/dev/null || die "Cannot pull $img. Check the version and your network."
  fi
  if [ -n "$IMAGES" ]; then
    [ -f "$IMAGES" ] || die "Images file not found: $IMAGES"
    cp "$IMAGES" "$DIR/images.json"
  fi
  say "Configuring $ENGINES ($VERSION) in $DIR"
  # As root: configure writes the install directory and sets ownership the
  # gateway and the engines need. The image itself runs unprivileged.
  # The catalog and localAI's machines, for OpenClaw's agents when machines
  # were loaded beyond the shipped corpus (created empty on a first install).
  proj="$PROJECT"
  [ -f "$DIR/.env" ] && proj="$(sed -n 's/^COMPOSE_PROJECT_NAME=//p' "$DIR/.env")"
  set -- docker run --rm --user 0:0 -v "$DIR:/install" -e "HOST_IP=$(host_ip)" \
    -e "HOST_INSTALL_DIR=$DIR" -e "HOST_UID=$(id -u)" -e "HOST_GID=$(id -g)" \
    -v "${proj}_corpus-catalog:/volumes/catalog:ro" -v "${proj}_localai-machines:/opt/localAIStack/data/machines:ro"
  for v in $(env | sed -n 's/^\(RE_PORT_[A-Z_]*\)=.*/\1/p'); do set -- "$@" -e "$v"; done
  set -- "$@" "$img" configure --install /install --engines "$ENGINES" --version "$VERSION" --registry "$REGISTRY" --project "$proj"
  [ -f "$DIR/images.json" ] && set -- "$@" --images /install/images.json
  "$@"
  save_conf
}

pull_images() {
  if [ "$LOCAL" = true ]; then return 0; fi
  say "Pulling the release images (the first install downloads about 15 GB)"
  compose pull --quiet || die "Pulling the images failed."
}

start() {
  say "Starting"
  compose up -d --remove-orphans
  wait_healthy
  # Engines boot the shipped corpus; machines loaded since are reloaded.
  machines_run machines-load --replay || warn "Reloading the machines loaded earlier reported failures."
  # After the replay: it regenerates the gateway's agents for the deployed corpus.
  gateway_up
  reembed_if_needed
}

# localAI's collections are filled by one embedding model, and vectors from two
# models do not mix. After a start, if the embedder no longer matches what filled
# them (an upgrade changed the default, or EMBED_MODEL did), rebuild them behind an
# alias; the old collection is kept and `realityengine reembed rollback` undoes it.
# An image that predates re-embedding has nothing to run, which is not an error.
reembed_if_needed() {
  if ! compose exec -T localai-api python -c 'import reembed_cli' >/dev/null 2>&1; then
    return 0
  fi
  if compose exec -T localai-api python -m reembed_cli status >/dev/null 2>&1; then
    return 0
  fi
  say "localAI's collections were embedded by a different model than the one now selected; re-embedding"
  compose exec -T localai-api python -m reembed_cli run \
    || warn "Re-embedding reported a problem. See: $PROG reembed status. Retrieval is refused, not wrong, until it is fixed."
}

# re-init's machine commands run on the install's network, with its catalog
# volume, so they reach Manager and every engine by their container names.
machines_run() {
  # shellcheck disable=SC1091
  . "$DIR/.env"
  docker run --rm --user 0:0 --network "$COMPOSE_PROJECT_NAME" -v "$DIR:/install" \
    -v "${COMPOSE_PROJECT_NAME}_corpus-catalog:/volumes/catalog" \
    -v "${COMPOSE_PROJECT_NAME}_localai-machines:/opt/localAIStack/data/machines:ro" "$RE_IMAGE_INIT" "$@"
}

wait_healthy() {
  say "Waiting for every service to be ready (a first start takes several minutes)"
  deadline=$(( $(date +%s) + ${REALITYENGINE_WAIT:-900} ))
  while :; do
    # '|'-separated: a service with no health check has an empty Health, which
    # whitespace splitting would collapse into the next field.
    states="$(compose ps -a --format '{{.Service}}|{{.State}}|{{.Health}}|{{.ExitCode}}' 2>/dev/null)"
    pending="$(printf '%s\n' "$states" \
      | awk -F'|' '($2=="running" && $3!="" && $3!="healthy") || $2=="created" || $2=="restarting" {print $1}' \
      | tr '\n' ' ')"
    failed="$(printf '%s\n' "$states" | awk -F'|' '$2=="exited" && $4!="0" {print $1}' | tr '\n' ' ')"
    [ -z "$failed" ] || die "Service(s) failed: $failed. See: $PROG logs <service>"
    [ -n "$pending" ] || break
    [ "$(date +%s)" -lt "$deadline" ] || die "Still not ready after ${REALITYENGINE_WAIT:-900}s: $pending. See: $PROG status"
    sleep 5
  done
  ok "All services are ready"
}

urls() {
  # shellcheck disable=SC1091
  . "$DIR/.env"
  cat <<EOF

  Manager (Visualizer)   https://localhost:${RE_PORT_MANAGER_UI}
  Instance registry      http://localhost:${RE_PORT_REGISTRY}/re-registry.json
  localAI API            http://localhost:${RE_PORT_LOCALAI}
  OpenClaw gateway       http://localhost:${RE_PORT_OPENCLAW}
  Open WebUI             http://localhost:${RE_PORT_WEBUI}   (${WEBUI_ADMIN_EMAIL})
  PIM                    http://localhost:${RE_PORT_PIM}
  Grafana                http://localhost:${RE_PORT_GRAFANA}  (admin)
  MCP                    http://localhost:${RE_PORT_MCP}

  Engines ($RE_ENGINES): see '$PROG status'. Passwords: $DIR/state/secrets.json
  Trust the local CA so browsers accept https://localhost: $PROG trust-ca
EOF
}

status() {
  [ -f "$DIR/release.json" ] || die "Nothing is installed in $DIR."
  say "Installed: $(sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "$DIR/release.json" | head -1), engines $(sed -n 's/.*"engines": *"\([^"]*\)".*/\1/p' "$DIR/release.json" | head -1)"
  compose ps -a --format 'table {{.Service}}\t{{.Status}}\t{{.Ports}}'
  if pid="$(gateway_pid)"; then
    ok "OpenClaw gateway: LaunchAgent $GATEWAY_LABEL, pid $pid, http://127.0.0.1:${RE_PORT_OPENCLAW:-18789} (log $DIR/openclaw/logs/gateway.log)"
  else
    warn "OpenClaw gateway: LaunchAgent $GATEWAY_LABEL is not running. Start it with: $PROG up"
  fi
  if [ -f "$DIR/state/host-services.json" ]; then
    say "Host services (checked $(sed -n 's/.*"checked_at": *"\([^"]*\)".*/\1/p' "$DIR/state/host-services.json" | head -1)):"
    grep -E '^  "(ollama|openclaw|node)"' "$DIR/state/host-services.json" | sed 's/^  /  /'
  fi
  if [ -f "$DIR/state/host-updates.md" ]; then
    warn "Host updates are available: see $DIR/state/host-updates.md"
  fi
}

# ── commands ─────────────────────────────────────────────────────────────────
case "$CMD" in
  install)
    VERSION="${VERSION:-release-v0.0.1}"
    preflight; check_ports; configure; pull_images; start; urls ;;
  up)
    [ -f "$CONF" ] || die "Nothing is installed in $DIR. Run: $PROG install"
    # A port held by something else makes compose leave that container half
    # created, without its network; refuse before starting anything.
    host_gate strict; gateway_down; check_ports; configure; pull_images; start; urls ;;
  down)
    gateway_down; compose down; ok "Stopped. Data is kept; '$PROG up' starts it again." ;;
  status) status ;;
  logs)
    # shellcheck disable=SC2086  # the service names, split on purpose
    compose logs --tail 200 ${ARGS_REST:-} ;;
  upgrade)
    [ -n "$TO" ] || die "Pass --to VERSION."
    VERSION="$TO"; host_gate strict; check_ollama; gateway_down; check_ports; configure; pull_images; start; urls ;;
  uninstall)
    gateway_down
    rm -f "$HOME/Library/LaunchAgents/$GATEWAY_LABEL.plist"
    if [ "$PURGE" = true ]; then
      compose down -v --remove-orphans || true
      rm -rf "$DIR"; ok "Removed the install and all its data."
    else
      compose down --remove-orphans || true
      ok "Removed the containers. Data and configuration are kept in $DIR and the Docker volumes; '--purge' deletes them."
    fi ;;
  trust-ca)
    [ -f "$DIR/certs/ca.crt" ] || die "No CA in $DIR/certs."
    say "Adding $DIR/certs/ca.crt to your login keychain as trusted (macOS will ask for your password)"
    security add-trusted-cert -r trustRoot -k "$HOME/Library/Keychains/login.keychain-db" "$DIR/certs/ca.crt"
    ok "Trusted. Restart your browser." ;;
  host-check)
    # Usable with nothing installed (the regression lane and startUniverse.sh call
    # it). --warn-only never fails; --json prints what was recorded.
    mkdir -p "$DIR" 2>/dev/null || true
    case "${ARGS_REST:-}" in
      *--json*) host_check >/dev/null 2>&1 || true; host_services_json ;;
      *--warn-only*) host_gate warn ;;
      *) host_gate strict ;;
    esac ;;
  reembed)
    [ -f "$DIR/.env" ] || die "Nothing is installed in $DIR."
    # shellcheck disable=SC2086  # the subcommand and collection names, split on purpose
    compose exec -T localai-api python -m reembed_cli ${ARGS_REST:-status} ;;
  machines)
    [ -f "$DIR/.env" ] || die "Nothing is installed in $DIR."
    sub="$(printf '%s' "${ARGS_REST:-}" | awk '{print $1}')"
    case "$sub" in
      list) machines_run machines-list ;;
      sync) machines_run machines-sync --ref "$REF"
            ok "Catalog refreshed. Load machines from it with: $PROG machines load --domain <name>" ;;
      load) if [ "$ALL" = true ]; then LOAD_ARGS="$LOAD_ARGS --all"; fi
            [ -n "$LOAD_ARGS" ] || die "Name what to load: --domain <name>, --machine <id> or --all."
            rc=0
            # shellcheck disable=SC2086  # the flags, split on purpose
            machines_run machines-load $LOAD_ARGS || rc=$?
            # OpenClaw's agents were regenerated for the deployed corpus.
            gateway_up || warn "Could not restart the OpenClaw gateway."
            exit "$rc" ;;
      *) die "Usage: $PROG machines list | sync [--ref REF] | load --domain D | --machine M | --all" ;;
    esac ;;
  -h|--help|help) usage 0 ;;
  *) usage 1 ;;
esac
